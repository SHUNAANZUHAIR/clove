DATABASE_URL=
DATABASE_URL_UNPOOLED=
PG_POOL_MAX=5

# Secret used to sign session cookies. Set this to a long random value in
# every environment (Vercel project settings, not just .env.local). Without
# it, sessions fall back to a publicly known default and can be forged.
# Generate one with: openssl rand -hex 32
CLOVEHR_AUTH_SECRET=

# Dedicated secret for ChatGPT Actions and workflow clients. Generate a long,
# random value and do not reuse a CloveHR login password.
CLOVEHR_WORKFLOW_API_KEY=
# Use -1 for all sites or a positive site id to restrict workflow access.
CLOVEHR_WORKFLOW_SITE_ID=-1
