DATABASE_URL=
DATABASE_URL_UNPOOLED=
PG_POOL_MAX=5

# Secret used to sign session cookies. Set this to a long random value in
# every environment (Vercel project settings, not just .env.local) — without
# it, sessions fall back to a publicly-known default and can be forged.
# Generate one with: openssl rand -hex 32
CLOVEHR_AUTH_SECRET=
